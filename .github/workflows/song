name: Gerar APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Listar arquivos
        run: find . -not -path './.git/*' -type f | head -60
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - name: Compilar APK
        run: |
          F=$(find . -name settings.gradle.kts -not -path './.git/*' | head -1)
          if [ -z "$F" ]; then echo "ERRO: settings.gradle.kts nao foi enviado ao repositorio"; exit 1; fi
          cd "$(dirname "$F")"
          gradle assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: TravaVolume-apk
          path: "**/app-debug.apk"
